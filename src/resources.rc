// resources.rc - Embedded data files for FF8 Accessibility Mod
//
// All VTT audio description files and mapping data are compiled into the DLL
// as RCDATA resources. End users only need dinput8.dll — no external files.
//
// Resource ID scheme for disc VTTs: base + FMV number
//   disc00 = 1000+N, disc01 = 2000+N, disc02 = 3000+N, disc03 = 4000+N, disc04 = 5000+N

#include "resources.h"

