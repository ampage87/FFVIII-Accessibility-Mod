@@ -50,6 +76,45 @@ static int __cdecl HookedGetKeyState()
                 kbBuf[0x50] = 0;  // Down
                 kbBuf[0x4B] = 0;  // Left
                 kbBuf[0x4D] = 0;  // Right
+
+                // v0.15.9.11: Chase-scene item #3 -- extended keyboard suppression
+                // during engaged Auto chase. Predicate is narrower than the arrow-
+                // zeroing above because the additional keys aren't always safe to
+                // zero -- F9 path-finding and world-map AD let the player use
+                // W/A/D normally (and W is the car's reverse, A is the car's gas).
+                // Only chase auto-pilot in MODE_AUTO with the chase ASK already
+                // answered (IsEngaged() requires s_askAnswered) gets the extra
+                // suppression. This means during the chase ASK navigation itself
+                // (cursor and confirm presses on the three options), the predicate
+                // is false and the player's X confirm flows through normally.
+                //
+                // Per Aaron's v0.15.9.11 design clarification (2026-05-12): the FF8
+                // default control set is arrows + W/A/D/X/S; we suppress everything
+                // except S so the player can still pause mid-chase. Listening for
+                // the audio cue from a successful S press is the player's confirmation
+                // that pause works.
+                if (::ChaseAutoPilot::IsEngaged()
+                    && ::ChaseDetector::GetChaseMode() == ::ChaseDetector::MODE_AUTO) {
+                    static bool s_chaseKbSuppressLogged = false;
+                    if (!s_chaseKbSuppressLogged) {
+                        s_chaseKbSuppressLogged = true;
+                        Log::Field("FieldNavigation: [v0.15.9.11] chase Auto kb "
+                                   "suppressor active: zeroing W A D X "
+                                   "(W=%02X A=%02X D=%02X X=%02X) -- S preserved "
+                                   "for pause, F-keys + mod GetAsyncKeyState hotkeys "
+                                   "untouched (mod hotkeys gated separately in "
+                                   "HandleKeys)",
+                                   kbBuf[0x11], kbBuf[0x1E], kbBuf[0x20], kbBuf[0x2D]);
+                    }
+                    kbBuf[0x11] = 0;  // W (default walk modifier; chase_auto_pilot owns
+                                      // walk state via StartDirectionDrive(walk=...))
+                    kbBuf[0x1E] = 0;  // A (default rotate/move-left; would fight analog)
+                    kbBuf[0x20] = 0;  // D (default rotate/move-right; would fight analog)
+                    kbBuf[0x2D] = 0;  // X (default confirm; could trigger entity interact)
+                    // NOTE: 0x1F = S is deliberately NOT zeroed. S is FF8's pause
+                    // function; preserving it lets the player pause the chase if
+                    // needed without breaking the suppression invariant.
+                }
             }
         } __except(EXCEPTION_EXECUTE_HANDLER) {}
     }
