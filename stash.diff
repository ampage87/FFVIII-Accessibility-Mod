@@ -15,6 +15,54 @@ static void HandleKeys()
     // \ (backslash) toggles auto-drive to selected entity.
     bool drive = (GetAsyncKeyState(VK_OEM_5) & 0x8000) != 0;
 
+    // v0.15.9.11: Chase-scene item #3 -- mod hotkey suppression during engaged
+    // Auto chase. Aaron's instruction (2026-05-12): "disable the mod's entity
+    // catalog - and = keys, as well as the backspace and \ shortcuts for
+    // setting navigation targets. Essentially, we're disabling everything
+    // except the F# keys for audio/TTS control and S to pause."
+    //
+    // These four hotkeys (-, =, Backspace, \) are read above via
+    // GetAsyncKeyState, which BYPASSES the engine keyboard buffer entirely.
+    // That means the kbBuf zeroing in field_nav_input_hooks.inl::HookedGetKeyState
+    // (which suppresses FF8's W/A/D/X engine keys) does NOT reach these.
+    // We have to gate them at the dispatch level.
+    //
+    // Predicate matches the kbBuf zeroing's chase-Auto predicate exactly:
+    // ChaseAutoPilot::IsEngaged() requires s_askAnswered, so during the chase
+    // ASK navigation itself the gate is open (player can use - / = to navigate
+    // the entity catalog normally before committing the chase mode). Only
+    // after the user picks Auto and the auto-pilot engages does suppression
+    // kick in.
+    //
+    // We still update the s_*WasDown statics inside the gate before returning
+    // so the edge-detect is consistent: if the user holds - during chase and
+    // releases after chase ends, no spurious edge fires; if the user starts
+    // a fresh press after chase ends, the edge fires normally.
+    //
+    // Other mod hotkeys NOT in this gate (F-keys for audio/TTS, V for version,
+    // G/T/L/R for game stat lookups, ` for repeat, / for help, etc.) are
+    // dispatched in dinput8.cpp and other modules. They remain functional
+    // during the chase because they're informational and don't disrupt the
+    // route. If a specific non-listed hotkey needs gating too, add it to the
+    // appropriate handler in a follow-up version.
+    bool chaseAutoEngaged = ::ChaseAutoPilot::IsEngaged()
+                         && ::ChaseDetector::GetChaseMode() == ::ChaseDetector::MODE_AUTO;
+    if (chaseAutoEngaged) {
+        static bool s_chaseHandleKeysSuppressLogged = false;
+        if (!s_chaseHandleKeysSuppressLogged) {
+            s_chaseHandleKeysSuppressLogged = true;
+            Log::Field("FieldNavigation: [v0.15.9.11] chase Auto HandleKeys "
+                       "suppressor active: -, =, Backspace, \\ disabled until "
+                       "chase ends");
+        }
+        // Preserve edge-detect state so post-chase presses fire cleanly.
+        s_minusWasDown  = minus;
+        s_plusWasDown   = plus;
+        s_bkspWasDown   = bksp;
+        s_driveWasDown  = drive;
+        return;
+    }
+
     // v0.14.75: F11 VISDIAG dump removed. Was a v05.69 research diagnostic
