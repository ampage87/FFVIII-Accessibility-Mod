+// Outside the chase, it returns CallNextHookEx unchanged so all input
+// flows normally.
+//
+// Hook proc constraints. Windows enforces a timeout on LL hooks; if the
+// proc takes too long, Windows unhooks us. Our check is O(1): read flags,
+// compare vkCode to ~8 constants, query two inline accessors. Both
+// `ChaseAutoPilot::IsEngaged()` and `ChaseDetector::GetChaseMode()` return
+// single bool/enum values that are atomically readable on x86, so cross-
+// thread access (hook on game main thread, state set on accessibility
+// thread) is safe without locks.
+//
+// Interaction with mod hotkeys. The mod's F-keys (audio/TTS), V, G/T/L/R,
+// etc. are read via GetAsyncKeyState from the accessibility thread. The LL
+// hook does NOT swallow any of them, so they reach the OS normally and
+// GetAsyncKeyState sees them as pressed. The mod's nav hotkeys (-, =,
+// Backspace, \) are ALSO read via GetAsyncKeyState but are gated separately
+// in field_nav_handlekeys.inl's HandleKeys early-return; the LL hook does
+// NOT touch them either, leaving HandleKeys as the sole gate for those.
+//
+// Compatibility. WH_KEYBOARD_LL is a global hook. Multiple LL hooks form a
+// chain. NVDA doesn't intercept arrow keys for FF8, so our hook fires and
+// can swallow as needed. JAWS intercepts arrows until Insert+3 passthrough
+// is engaged -- that's a pre-existing JAWS behavior, not a regression from
+// this hook.
+
+static HHOOK s_llKeyboardHook = nullptr;
+
+static LRESULT CALLBACK LowLevelKeyboardProc(int nCode, WPARAM wParam, LPARAM lParam)
+{
+    if (nCode == HC_ACTION && lParam != 0) {
+        KBDLLHOOKSTRUCT* k = reinterpret_cast<KBDLLHOOKSTRUCT*>(lParam);
+        const bool isInjected = (k->flags & LLKHF_INJECTED) != 0;
+        if (!isInjected) {
+            // Only check chase state if the key is a candidate for suppression.
+            // Avoids ChaseAutoPilot::IsEngaged() / ChaseDetector::GetChaseMode()
+            // calls on every non-game keystroke (typing in a text editor, etc.).
+            const DWORD vk = k->vkCode;
+            const bool isArrow =
+                vk == VK_UP || vk == VK_DOWN || vk == VK_LEFT || vk == VK_RIGHT;
+            const bool isGameKey =
+                vk == 'W' || vk == 'A' || vk == 'D' || vk == 'X';
+            // 'S' (VK 0x53) is NOT in the suppressed set: it's FF8's pause
+            // key and Aaron retains pause access mid-chase.
+            if (isArrow || isGameKey) {
+                const bool chaseAutoEngaged =
+                    ChaseAutoPilot::IsEngaged() &&
+                    ChaseDetector::GetChaseMode() == ChaseDetector::MODE_AUTO;
+                if (chaseAutoEngaged) {
+                    static bool s_llSuppressLogged = false;
+                    if (!s_llSuppressLogged) {
+                        s_llSuppressLogged = true;
+                        Log::Field("FieldNavigation: [v0.15.9.11.1] LL keyboard hook "
+                                   "first suppressed key vk=0x%02X (flags=0x%X) "
+                                   "during chase Auto -- physical arrows + W/A/D/X "
+                                   "will no longer reach FFNx or the engine; "
+                                   "S/F-keys/mod hotkeys remain functional",
+                                   vk, (unsigned)k->flags);
+                    }
+                    return 1;  // swallow: do NOT call CallNextHookEx
+                }
+            }
+        }
+    }
+    return CallNextHookEx(nullptr, nCode, wParam, lParam);
+}
+
+static void InstallLowLevelKeyboardHook(HMODULE hModule)
+{
+    if (s_llKeyboardHook != nullptr) return;  // already installed
+    s_llKeyboardHook = SetWindowsHookExW(WH_KEYBOARD_LL,
+                                         LowLevelKeyboardProc,
+                                         hModule,
+                                         0);
+    if (s_llKeyboardHook) {
+        Log::Mod("AccessibilityThread: [v0.15.9.11.1] WH_KEYBOARD_LL hook installed "
+                   "(handle=0x%p) for chase Auto arrow + W/A/D/X suppression. "
+                   "S (pause), F-keys, and mod hotkeys remain functional.",
+                   s_llKeyboardHook);
+    } else {
+        DWORD err = GetLastError();
+        Log::Mod("AccessibilityThread: [v0.15.9.11.1] WARNING - "
+                   "SetWindowsHookExW(WH_KEYBOARD_LL) FAILED with error 0x%lX. "
+                   "Chase Auto arrow suppression is DISABLED for this session; "
+                   "Aaron's arrow presses will still interrupt chase auto-pilot "
+                   "as in v0.15.9.11.", err);
+    }
+}
+
+static void UninstallLowLevelKeyboardHook()
+{
+    if (s_llKeyboardHook) {
+        UnhookWindowsHookEx(s_llKeyboardHook);
+        Log::Mod("AccessibilityThread: [v0.15.9.11.1] WH_KEYBOARD_LL hook uninstalled");
+        s_llKeyboardHook = nullptr;
+    }
+}
